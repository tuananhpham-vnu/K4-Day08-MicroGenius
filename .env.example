# Gemini API Key (used by Task 10 generation)
GEMINI_API_KEY=...
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# OpenRouter API Key (used by RAGAS evaluation)
OPENROUTER_API_KEY=sk-or-v1-...
RAGAS_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Lab8 RAG Evaluation

# DeepSeek API Key (optional, not used by current Task 10/RAGAS config)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_GENERATION_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API Key (optional)
# OPENAI_API_KEY=sk-proj-...

